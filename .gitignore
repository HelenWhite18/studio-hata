# Local configuration and secrets
.env
.env.*
!.env.example
auth.json

# Operating system and editor files
.DS_Store
.idea/
.vscode/
*.swp

# Codex project-mirror instructions; not part of the website repository.
AGENTS.md
sources/

# Dependencies and build output
vendor/
node_modules/
dist/
coverage/
__pycache__/

# WordPress runtime content
wp-content/cache/
wp-content/languages/
wp-content/uploads/
wp-content/upgrade/
wp-content/backup*/
wp-content/ai1wm-backups/
wp-content/debug.log

# Third-party plugins are installed per environment, not committed.
wp-content/plugins/*
!wp-content/plugins/.gitkeep

# Track the two project themes; ignore third-party themes such as Kadence.
wp-content/themes/*
!wp-content/themes/studio-hata/
!wp-content/themes/studio-hata/**
!wp-content/themes/hata-kadence/
!wp-content/themes/hata-kadence/**

# Local-only generated photography used while final HATA imagery is pending.
wp-content/themes/studio-hata/assets/images/placeholders/
wp-content/themes/hata-kadence/assets/img/placeholders/

# Local database exports
*.sql
*.sql.gz
